

# Used for authenticating TMBD requests, can be acquired by making a new account on TMDB's website and getting one from your profile
# https://www.themoviedb.org/
TMDB_API_KEY=YOUR_TMBD_API_KEY_HERE

# JWT tokens are used for authentication (use secure and preferrably randomly generated ones)
JWT_ACCESS_SECRET=ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=REFRESH_SECRET_HERE

# TMBD token, can also be acquired from the TMDB website.
VITE_TMDB_TOKEN=YOUR_TMBD_TOKEN_HERE


# When running the website locally, use localhost for your FRONTEND_URL
# Otherwise put the IP of the server your frontend will be running on
FRONTEND_URL=http://localhost:5173


# Put your Postgres user's name and password here, as well as the name of your new database.
POSTGRES_USER=YOUR_USER_HERE
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE
POSTGRES_DB=YOUR_DATABASE_NAME_HERE

# DB_HOST is the database's hostname, it tells the backend where to find your PostgreSQL database.
# Use "db" if running with docker compose, if you're running your backend locally use localhost
DB_HOST=db
DB_USER=YOUR_USER_HERE
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_NAME=YOUR_DATABASE_NAME_HERE


