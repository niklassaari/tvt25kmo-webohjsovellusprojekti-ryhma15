# Set the TMDB API url in the VITE_TMBD_API_URL variable, and your personal TMBD Token in the VITE_TMBD_TOKEN variable.
# You can generate your own token by creating an account on the TMBD website.
# https://www.themoviedb.org/

VITE_TMDB_API_URL=https://api.themoviedb.org/3
VITE_TMDB_TOKEN=YOUR_TOKEN_HERE

# Set the url of your backend API
# When running the website locally, use localhost
# Otherwise put the IP of the server your backend will be running on.

VITE_API_URL=http://localhost:3001
